---
import { getLangFromUrl, swapLocaleInPath, t } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const otherLang = currentLang === 'en' ? 'es' : 'en';
const href = swapLocaleInPath(Astro.url.pathname, otherLang);
---
<a
  
  data-lang-toggle
  data-current-lang={currentLang}
  class="fixed liquid-glass top-4 right-4 md:top-6 md:right-6 z-50 h-12 min-w-12 px-4 rounded-full bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 text-white text-sm md:text-base font-semibold flex items-center justify-center transition-colors hover:cursor-pointer "
  aria-label={t(currentLang, 'nav.lang.toggle')}
  title={t(currentLang, 'nav.lang.toggle')}
  onclick={`window.location.href = ${href}; `}
>
  <span class="uppercase tracking-widest">{t(currentLang, 'nav.lang.shortLabel')}</span>
</a>