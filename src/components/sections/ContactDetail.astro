---
// Contact detail view. Renders an infinite horizontal marquee with the
// contact links (currently 4). The track is duplicated and translated
// continuously via a GSAP timeline. Respects prefers-reduced-motion by
// showing the icons in a static row instead of animating.
import { contactLinks } from '../../lib/contactLinks';
import { t, type Lang } from '../../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props as Props;
---

<div
  id="contactDetailedView"
  class="contents hidden"
  data-section-detail
  data-section-id="contact"
>
  <h2
    class:list={["col-start-1 col-span-2 row-start-1 self-start justify-self-start pt-6 pl-20 text-3xl md:text-5xl tron-font text-secondary", lang === 'es' ? '' : 'hidden']}
    data-lang="es"
  >{t('es', 'sections.contact.title')}</h2>
  <h2
    class:list={["col-start-1 col-span-2 row-start-1 self-start justify-self-start pt-6 pl-20 text-3xl md:text-5xl tron-font text-secondary", lang === 'en' ? '' : 'hidden']}
    data-lang="en"
  >{t('en', 'sections.contact.title')}</h2>

  <div
    class="contact-content col-start-1 col-span-3 row-start-2 row-span-2 flex items-center justify-center overflow-hidden"
    data-section-content
  >
    <p
      class:list={["text-lg text-white/70 max-w-xl text-center px-6 mb-8 absolute top-1/3 left-1/2 -translate-x-1/2 z-10 pointer-events-none", lang === 'es' ? '' : 'hidden']}
      data-lang="es"
    >{t('es', 'sections.contact.body')}</p>
    <p
      class:list={["text-lg text-white/70 max-w-xl text-center px-6 mb-8 absolute top-1/3 left-1/2 -translate-x-1/2 z-10 pointer-events-none", lang === 'en' ? '' : 'hidden']}
      data-lang="en"
    >{t('en', 'sections.contact.body')}</p>

    <div
      class="contact-marquee-mask w-full overflow-hidden"
      data-marquee-mask
    >
      <div
        class="contact-marquee-track flex items-center gap-12 whitespace-nowrap will-change-transform"
        data-marquee-track
      >
        {contactLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-marquee-item flex flex-col items-center gap-2 text-white/80 hover:text-secondary transition-colors min-w-30"
            aria-label={link.label}
            set:html={`<span class="w-16 h-16">${link.iconSvg}</span><span class="text-sm uppercase tracking-widest">${link.label}</span>`}
          />
        ))}
        <!-- Duplicated so the timeline can loop seamlessly from 0% to -50% -->
        {contactLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-marquee-item flex flex-col items-center gap-2 text-white/80 hover:text-secondary transition-colors min-w-30"
            aria-label={link.label}
            set:html={`<span class="w-16 h-16">${link.iconSvg}</span><span class="text-sm uppercase tracking-widest">${link.label}</span>`}
          />
        ))}
      </div>
    </div>
  </div>
  <!-- 3D model anchor positioned within this section -->
  <div id="modelBg" class="fixed  w-[33vw] h-[33vh] top-1/2 right-1/2 transform -translate-y-1/2 -translate-x-1/2 pointer-events-none z-0"></div>
  <!-- Close button for this section's detail view -->
  <button
    id="detail-close"
    type="button"
    class="hidden fixed top-4 left-4 md:top-6 md:left-6 w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 text-white text-2xl flex items-center justify-center transition-colors z-55"
    aria-label={t(lang, 'ui.closeDetailAria')}
    data-i18n-attr={`aria-label:ui.closeDetailAria`}
  >&lsaquo;</button>
</div>

<script>
  import { gsap } from 'gsap';

  // Drive a horizontal marquee. The track is rendered twice (the original
  // items followed by a clone), so translating from 0 to -50% creates a
  // seamless infinite loop.
  const startMarquee = (root: HTMLElement): gsap.core.Tween | null => {
    const track = root.querySelector<HTMLElement>('[data-marquee-track]');
    if (!track) return null;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion) {
      gsap.set(track, { x: 0 });
      return null;
    }

    const tween = gsap.to(track, {
      x: '-50%',
      duration: 20,
      ease: 'none',
      repeat: -1,
    });

    return tween;
  };

  const applyContactLang = (root: HTMLElement) => {
    const lang = (document.documentElement.lang || 'es') as 'es' | 'en';
    root.querySelectorAll<HTMLElement>('[data-lang]').forEach((el) => {
      el.classList.toggle('hidden', el.dataset.lang !== lang);
    });
  };

  const setupContact = (root: HTMLElement) => {
    if (root.dataset.contactInit === 'true') return;
    root.dataset.contactInit = 'true';

    applyContactLang(root);

    const observer = new MutationObserver(() => applyContactLang(root));
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['lang'],
    });
  };

  const startContact = () => {
    const root = document.querySelector<HTMLElement>('#contactDetailedView');
    if (!root) return;
    setupContact(root);
    startMarquee(root);
  };

  const bootstrap = () => {
    const root = document.querySelector<HTMLElement>('#contactDetailedView');
    if (root) setupContact(root);
  };
  document.addEventListener('astro:page-load', bootstrap);
  if (document.readyState !== 'loading') {
    bootstrap();
  } else {
    document.addEventListener('DOMContentLoaded', bootstrap, { once: true });
  }

  (window as unknown as { __contactHooks?: unknown }).__contactHooks = {
    start: startContact,
  };
</script>