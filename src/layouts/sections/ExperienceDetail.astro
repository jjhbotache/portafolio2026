---
// Experience detail view. Lists every entry from the `experiences` content
// collection as a horizontal card. Each card has the meta on the left and a
// vertical Swiper with the project screenshots on the right. Cards are
// driven by a horizontal scroll bound to the page's vertical scroll (GSAP
// ScrollTrigger with pin + scrub) so they appear to move from right to left
// as the user scrolls down, stacking in the viewport.
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import { Icon } from 'astro-icon/components';
import { Swiper, SwiperWrapper, SwiperSlide, SwiperPagination, SwiperButtonNext, SwiperButtonPrev } from 'astro-swiper';
import { resolveBilingual, t, type Lang } from '../../i18n/utils';
import DetailCloseButton from '../../components/sections/DetailCloseButton.astro';
import ImageLightbox from '../../components/sections/ImageLightbox.astro';
import ModelBgAnchor from '../../components/sections/ModelBgAnchor.astro';
import SectionTitle from '../../components/sections/SectionTitle.astro';
import ScrollDownTutorial from '../../components/sections/ScrollDownTutorial.astro';


interface Props { lang: Lang }
const { lang } = Astro.props as Props;

const experiences = await getCollection('experiences');

// Sort by `importance` (descending) so the most prominent roles lead the
// horizontal scroll. We sort on a copy to avoid mutating the collection
// returned by Astro's `getCollection`.
const sortedExperiences = [...experiences].sort(
  (a, b) => b.data.importance - a.data.importance,
);

// Short month names come from the i18n dictionary so they switch with the
// URL locale without a hardcoded `monthsEs` / `monthsEn` pair.
const noImagesLabel = t(lang, 'experience.noImages');

// Convert every experience into a fully-resolved, pre-rendered payload so
// the client doesn't need to re-resolve bilingual fields or re-parse the
// markdown body on every open.
interface ResolvedExperience {
  id: string;
  title: string;
  period: string;
  description: string;
  contentHtml: string;
  technologies: string[];
  imgs: string[];
  periodByLang: { es: string; en: string };
  enterprises: { name: string; logo: string; url: string }[];
  // Unique pagination class per card. Swiper 12's default `pagination.el`
  // is the bare tag name `swiper-pagination` (no dot), so astro-swiper's
  // `<div class="swiper-pagination">` is never picked up automatically
  // and the bullets never initialize. We need a per-card unique class so
  // (a) Swiper finds the right element, and (b) bullets don't leak across
  // the multiple swipers rendered on this page.
  paginationClass: string;
}

const buildPeriod = (exp: typeof experiences[number], monthList: string[]) =>{
  let end = '';
  if (!exp.data.end) {
   end = t(lang, 'experience.present');
  }else{
    end = monthList[exp.data.end.month - 1] + ' ' + exp.data.end.year;
  }
  return  `${monthList[exp.data.start.month - 1]} ${exp.data.start.year} — ${end}`
};

const resolvedExperiences: ResolvedExperience[] = sortedExperiences.map((exp) => {
  const periodEs = buildPeriod(exp, t('es', 'months.short') as unknown as string[]);
  const periodEn = buildPeriod(exp, t('en', 'months.short') as unknown as string[]);

  const title = resolveBilingual(exp.data.title, lang) ?? '';
  const description = resolveBilingual(exp.data.description, lang) ?? '';
  const contentMd = resolveBilingual(exp.data.content, lang) ?? '';
  const technologies = (resolveBilingual(exp.data.technologies, lang) ?? []) as string[];
  const enterprises = exp.data.enterprises.map((ent) => ({
    name: resolveBilingual(ent.name, lang) ?? '',
    logo: ent.logo,
    url: ent.url,
  }));

  return {
    id: exp.id,
    title,
    period: lang === 'es' ? periodEs : periodEn,
    description,
    contentHtml: marked.parse(contentMd) as string,
    technologies,
    imgs: exp.data.imgs,
    periodByLang: { es: periodEs, en: periodEn },
    enterprises,
    paginationClass: `swiper-pagination-${exp.id}`,
  };
});
---

<!-- Section wrapper: contains the title, content, 3D model anchor and close
     button. Uses `display: contents` so the children participate in the
     parent (#detail-overlay) grid when the section is active. -->
<div
  id="experienceDetailRoot"
  class="contents pixel-font "
  data-section-detail
  data-section-id="experience"
>
<SectionTitle
  sectionId="experience"
  titleKey="sections.experience.title"
  lang={lang}
  size="large"
/>

<div
  id="experienceDetailedView"
  class=" row-start-2 col-span-3 row-span-2 text-white text-center pointer-events-auto overflow-y-auto overflow-x-hidden tiny-scrollbar"
  data-section-detail
  data-section-id="experience"
  data-section-content
>
  <div
    class="experience-content max-h-full h-full sticky top-0 "
  >
    <div class="experience-track relative w-full h-full  ">

      {resolvedExperiences.map((exp) => (
      <article
            class="experience-card group min-w-2/3 absolute inset-y-0 left-5 md:left-20 h-[90%]  w-[80vw] md:w-[60vw] max-w-3xl p-6 flex flex-col md:flex-row gap-6
            bg-linear-to-br from-primary to-blue-950 to-80%
            overflow-hidden
            justify-center items-center
            rounded-md
            "
            data-card-id={exp.id}
            id={`experienceCard-${exp.id}`}
            data-period-es={exp.periodByLang.es}
            data-period-en={exp.periodByLang.en}
            onclick={`event.stopPropagation(); this.classList.contains('is-expanded') && this.classList.remove('is-expanded'); `}
          >
            <div class="md:w-2/5 contents md:flex flex-col justify-center gap-3 overflow-y-auto pr-2 h-2/3 md:h-full ">
              <h3 class="text-lg md:text-2xl font-bold leading-tight">{exp.title}</h3>
              <div class="flex flex-wrap items-center justify-center gap-3">
                {exp.enterprises.map((ent) => (
                  <a
                    href={ent.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 text-sm text-white/80 hover:text-secondary transition-colors underline"
                  >
                    <img
                      src={ent.logo}
                      alt={ent.name}
                      class="w-6 h-6 rounded-sm "
                      loading="lazy"
                    />
                    <span class="text-xs ">{ent.name}</span>
                  </a>
                ))}
              </div>
              <div class="group text-xs md:text-sm">
                <p class=" text-white/60 italic text-[0.5rem] " data-period-display >{exp.period}</p>
                <p class=" text-white/80 leading-relaxed text-[0.65rem] ">
                  {exp.description}
                  <span class="underline bold transition-all duration-300
                  hover:opacity-80 hover:cursor-pointer"
                  onclick={`event.stopPropagation(); document.querySelector("#experienceCard-${exp.id}").classList.add('is-expanded')`}
                  >
                    {t(lang, 'experience.viewMore')+". . ."}
                  </span>
                </p>
                 <div class="experience-data-overlay 
                  translate-y-full absolute bottom-0 left-0 w-full p-4 bg-black/70 backdrop-blur-sm flex-col gap-2 opacity-0 z-10
                  transition-all duration-300
                  group-[.is-expanded]:flex group-active:flex
                  group-[.is-expanded]:translate-y-0 group-active:translate-y-0
                  group-[.is-expanded]:opacity-100
                  "
                  onclick={`event.stopPropagation(); document.querySelector("#experienceCard-${exp.id}").classList.toggle('is-expanded')`}
                  >
                    <div class="flex flex-wrap justify-center gap-1.5">
                    {exp.technologies.map((tech, i) => (
                      <span class={` text-xs px-2 py-1 rounded-full bg-secondary/15 text-secondary border border-secondary/30
                      opacity-0
                      group-[.is-expanded]:opacity-100 group-active:opacity-100
                      transition-opacity duration-150
                      `}
                      style={`transition-delay: ${300 + (i*50)}ms;`}
                      >
                        {tech}
                      </span>
                    ))}
                    </div>
                    <div id={`experienceContent-${exp.id}`} class="mt-2 text-sm text-white/70 leading-relaxed prose prose-invert max-w-none" set:html={exp.contentHtml} />
                    <small class="text-xs text-white/50"> {t(lang, 'experience.closeDetail')} </small>
                    <script is:inline define:vars={{ expId: exp.id }}>
                      document.addEventListener('DOMContentLoaded', () => {
                        const container = document.getElementById(`experienceContent-${expId}`);
                        if (container) {
                          container.querySelectorAll('a').forEach(link => {
                            link.setAttribute('target', '_blank');
                            link.style.textDecoration = 'underline';
                          });
                        }
                      });
                    </script>
                  </div>
              </div>
            </div>
            <!-- slider -->
            <div class="md:w-3/5 w-full relative rounded-xl overflow-hidden bg-black/40 min-h-45 flex-1 md:h-full">
              {exp.imgs.length > 0 ? (
                <Swiper
                  class="h-full"
                  options={{
                    direction: 'horizontal',
                    loop: true,
                    grabCursor: true,
                    // Re-measure on parent resize: the detail section starts
                    // hidden (the overlay is `display:none`), so swiper
                    // initializes with width/height=0. Without these flags
                    // it never picks up the real dimensions once the section
                    // is shown, and every slide collapses to 0px.
                    observer: true,
                    observeParents: true,
                    pagination: {
                      el: `.${exp.paginationClass}`,
                      clickable: true,
                    },
                    navigation: {
                      nextEl: '.swiper-button-next',
                      prevEl: '.swiper-button-prev',
                    },
                  }}
                >
                  <SwiperWrapper class="h-full">
                    {exp.imgs.map((src, i) => (
                      <SwiperSlide class="h-full w-full bg-linear-to-br from-black/40 via-bg-black/5 to-black/40">
                        <img
                          src={src}
                          alt={exp.title}
                          data-lightbox-src={src}
                          data-lightbox-name={`lightbox-${exp.id}-${i}`}
                          data-lightbox-alt={exp.title}
                          style={`view-transition-name: lightbox-${exp.id}-${i};`}
                          class="w-full h-full object-contain object-center cursor-zoom-in"
                          loading="lazy"
                          decoding="async"
                        />
                      </SwiperSlide>
                    ))}
                  </SwiperWrapper>
                  <SwiperPagination class={exp.paginationClass} />
                  <SwiperButtonPrev class=" text-tertiary opacity-35  hover:opacity-100 transition-opacity duration-150" />
                  <SwiperButtonNext class=" text-tertiary opacity-35  hover:opacity-100 transition-opacity duration-150" />
                </Swiper>
              ) : (
                <div class="w-full h-full flex items-center justify-center text-white/40 text-sm">
                  {noImagesLabel}
                </div>
              )}
            </div>
      </article>
      ))}

      <ScrollDownTutorial
        lang={lang}
        sectionId="experience"
        storageKey="experience_tutorial_showns"
        maxShowTimes={0}
      />
    </div>
    <!-- add space to make it scrollable -->
    <div id="experienceSpacer"></div>

    <!-- Fullscreen image lightbox. Sits inside the detail overlay so it
        inherits the same lifecycle (mounted once, opened/closed by JS).
        The `view-transition-name` is set per-image dynamically so each
        thumbnail can FLIP into the enlarged image. -->
    <ImageLightbox lang={lang} />
    <DetailCloseButton lang={lang} />
  </div>
  <!-- 3D model anchor and close button shared by every detail section. -->
  <ModelBgAnchor mobileStyle='top-[35%] left-[37%]' />
</div>
</div>
<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { gsap } from 'gsap';
  import { playTitleIntroAnimation } from '../../lib/sectionTitleReveal';

  gsap.registerPlugin(ScrollTrigger);

  // Swipers are auto-initialized by the <astro-swiper> custom element, so
  // no manual `new Swiper(...)` calls are required here.

  // Drive a horizontal track with vertical scroll using a GSAP timeline.
  // The timeline owns the tween (track x) and the ScrollTrigger, so callers
  // can play / pause / refresh / kill it via the returned handle.
  //
  // IMPORTANT: this section uses `#detail-overlay` as the SCROLLER (the
  // element that actually scrolls, since it has `overflow-y-auto`) and
  // `#experienceDetailedView` as the TRIGGER (the element whose position
  // is measured against the scroller). The detail overlay sits on top of
  // a fixed three.js scene that consumes window scroll, so we cannot
  // listen to window scroll here — we listen to the overlay's scroll.
  //
  // The trigger element grows vertically via `growSection()` so the
  // overlay has enough scroll distance to drive the animation end-to-end.
  // The sticky content pins itself via CSS (`position: sticky; top: 0`)
  // and stays in view while the user scrolls past the extra height.
  type ExperienceAnimationHandle = {
    timeline: gsap.core.Timeline;
    scrollTrigger: ScrollTrigger;
    destroy: () => void;
  };

  const buildExperienceScroll = (root: HTMLElement): ExperienceAnimationHandle | null => {
    const track = root.querySelector<HTMLElement>('.experience-track');
    const content = root.querySelector<HTMLElement>('.experience-content');
    const wrapper = root.querySelector<HTMLElement>('#experienceDetailedView');

    if (!track || !root) return null;

    const cards = Array.from(track.querySelectorAll<HTMLElement>('.experience-card'));
    const numCards = cards.length;
    if (numCards === 0) return null;

    // Adaptive stack offset: limit it so the leftmost card never extends
    // past the track's left edge (the parent clips with overflow-x-hidden).
    const cardWidth = cards[0].offsetWidth;
    const trackWidth = track.offsetWidth;
    const maxStackWidth = Math.max(0, trackWidth - cardWidth);
    const desiredOffset = -50;
    const STACK_OFFSET_PX = numCards > 1
      ? Math.min(desiredOffset, maxStackWidth / (numCards - 1))
      : 0;


    const STEP_DURATION = 1;
    const totalDuration = Math.max(0, (numCards - 1) * STEP_DURATION);

    const timeline = gsap.timeline({
      paused: true,
      defaults: { ease: 'power2.inOut' },
    });
    
    // first set all except first card out of the view
    for (let k = 1; k < numCards; k++) {
      timeline.set(cards[k], { x: '100vw' });
    }
    

    // For each new card k (1..N-1):
    //   - all previously visible cards shift left by STACK_OFFSET
    //   - card[k] slides in from the right
    // Result: each card stays partially visible on the left as a stack,
    // with the newest card always on top.
    for (let k = 1; k < numCards; k++) {
      const segmentTime = (k - 1) * STEP_DURATION;
      
      // first set cards out of the view

      for (let i = 0; i < k; i++) {
        timeline.to(
          cards[i],
          // also delete shadow
          {
            x: `-=${STACK_OFFSET_PX}`,
            y: `-=${STACK_OFFSET_PX / 2}`,
            duration: STEP_DURATION
          },
          segmentTime,
        );
      }

      timeline.addLabel(`card-${k}`, segmentTime);
      timeline.fromTo(
        cards[k],
        { x: '100vw' },
        { x: 0, duration: STEP_DURATION },
        segmentTime,
      );

    }

    // One viewport of scroll per card transition.
    const getScrollDistance = () => totalDuration * window.innerHeight;

    const st = ScrollTrigger.create({
      scroller: wrapper,
      trigger: content,
      start: 'top top',
      end: () => `+=${getScrollDistance()}`,
      scrub: 0.1,
      // Snap the timeline to each card label when the user stops scrolling
      // so the view never rests halfway between two projects.
      snap: {
        snapTo: 'labels',
        duration: 0.3,
        ease: 'power1.inOut',
      },
      animation: timeline,
    });

    // Spacer height = scroll distance so the overlay has enough scroll room
    // to drive the animation end-to-end. Kept in sync with `end` via refresh.
    const spacer = document.querySelector<HTMLElement>('#experienceSpacer');
    if (spacer) {
      spacer.style.height = `${getScrollDistance()}px`;
    }

    return {
      timeline,
      scrollTrigger: st,
      destroy: () => {
        st.kill();
        timeline.kill();
      },
    };
  };

  // Show only the content matching the document's current language.
  const applyExperienceLang = (_root: HTMLElement) => {
    const lang = (document.documentElement.lang || 'es') as 'es' | 'en';
    document
      .querySelectorAll<HTMLElement>('[data-section-id="experience"][data-lang]')
      .forEach((el) => {
        el.classList.toggle('hidden', el.dataset.lang !== lang);
      });
    document.querySelectorAll<HTMLElement>('[data-period-display]').forEach((el) => {
      const card = el.closest<HTMLElement>('[data-card-id]');
      if (!card) return;
      el.textContent = card.dataset[lang === 'es' ? 'periodEs' : 'periodEn'] ?? '';
    });
  };

  // Setup: language observer and ScrollTrigger refresh. The scroll timeline
  // is built lazily (in startExperience) so the distance is measured with
  // the section actually visible, otherwise `scrollWidth` is 0 because the
  // parent grid item is hidden. Swipers are auto-initialized by the
  // <astro-swiper> custom element, so no manual init is required here.
  const setupExperience = (root: HTMLElement) => {
    if (root.dataset.experienceInit === 'true') return;
    root.dataset.experienceInit = 'true';

    applyExperienceLang(root);

    const observer = new MutationObserver(() => applyExperienceLang(root));
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['lang'],
    });

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => ScrollTrigger.refresh());
    }
    window.addEventListener('resize', () => ScrollTrigger.refresh());
  };

  // Stored handle to the scroll timeline. Rebuilt on each open so the
  // distance is computed with the section visible.
  let experienceHandle: ExperienceAnimationHandle | null = null;

  // ---------------------------------------------------------------------------
  // Lightbox control
  // ---------------------------------------------------------------------------
  // Click on any <img data-lightbox-src> inside the section opens a fullscreen
  // overlay with a FLIP animation. Implementation notes:
  //   - `view-transition-name` is shared between the thumbnail and the lightbox
  //     clone, so the browser interpolates position/transform/size/opacity
  //     between them. The thumbnail "gives" its name to the clone during
  //     `startViewTransition()` and the clone clears it after the transition.
  //   - Listeners are registered once per section lifecycle (not per open)
  //     and tracked by an AbortController so they can be torn down instantly
  //     when the section is closed or the page is swapped.
  //   - The `astro:before-swap` listener kills the lightbox state silently so
  //     a SPA navigation never leaves a stale overlay in the DOM.
  //   - Falls back to direct DOM mutation when `document.startViewTransition`
  //     is unavailable (Safari < 18).
  type VTDocument = Document & {
    startViewTransition?: (cb: () => void) => unknown;
  };

  const lightboxState = {
    root: null as HTMLElement | null,
    backdrop: null as HTMLElement | null,
    stage: null as HTMLElement | null,
    img: null as HTMLImageElement | null,
    closeBtn: null as HTMLButtonElement | null,
    aborter: null as AbortController | null,
    activeThumb: null as HTMLImageElement | null,
    activeName: null as string | null,
  };

  const findLightboxEl = (id: string): HTMLElement | null =>
    document.querySelector<HTMLElement>(`#${id}`);

  const setVTName = (el: HTMLElement | null, name: string | null): void => {
    if (!el) return;
    if (name) {
      el.style.viewTransitionName = name;
    } else {
      el.style.removeProperty('view-transition-name');
    }
  };

  // Preload an image so the FLIP destination has decoded pixels when the
  // transition starts. Without this the browser can flash a blank clone.
  const preloadImage = (src: string): Promise<HTMLImageElement> =>
    new Promise((resolve, reject) => {
      const img = new Image();
      img.decoding = 'async';
      img.onload = () => resolve(img);
      img.onerror = () => reject(new Error(`lightbox preload failed: ${src}`));
      img.src = src;
    });

  const openLightbox = async (thumb: HTMLImageElement, src: string, name: string, alt: string): Promise<void> => {
    if (!lightboxState.root || !lightboxState.img) return;
    if (lightboxState.root.classList.contains('is-open')) return;

    lightboxState.activeThumb = thumb;
    lightboxState.activeName = name;

    // Mark the thumbnail so the global CSS rule can hide every other
    // data-lightbox-src image (swiper loop clones included) during the
    // transition. This prevents the sibling slides from leaking through
    // while the FLIP animation is in flight.
    thumb.dataset.lightboxActive = 'true';
    document.body.dataset.lightboxActive = name;

    try {
      await preloadImage(src);
    } catch {
      // Swallow preload errors: the browser will still render the broken-
      // image placeholder inside the lightbox, which is fine.
    }

    lightboxState.img.src = src;
    lightboxState.img.alt = alt;
    lightboxState.root.setAttribute('aria-hidden', 'false');

    const doc = document as VTDocument;
    const transition = doc.startViewTransition?.(() => {
      // Hand the shared name over to the lightbox clone so the browser
      // captures the thumbnail's old geometry in `::view-transition-old`
      // and the lightbox's new geometry in `::view-transition-new`.
      setVTName(thumb, null);
      setVTName(lightboxState.img, name);
      lightboxState.root?.classList.add('is-open');
    });

    if (transition && typeof (transition as { finished?: Promise<void> }).finished?.then === 'function') {
      (transition as { finished: Promise<void> }).finished
        .catch(() => undefined)
        .finally(() => {
          // Drop the clone's name after the transition so the next open
          // doesn't reuse a stale snapshot.
          if (lightboxState.activeName === name) {
            setVTName(lightboxState.img, null);
          }
        });
    } else {
      setVTName(lightboxState.img, null);
    }

    lightboxState.closeBtn?.focus();
  };

  const closeLightbox = (): void => {
    if (!lightboxState.root || !lightboxState.activeThumb || !lightboxState.activeName) return;
    if (!lightboxState.root.classList.contains('is-open')) return;

    const thumb = lightboxState.activeThumb;
    const name = lightboxState.activeName;

    const doc = document as VTDocument;
    const transition = doc.startViewTransition?.(() => {
      // Reverse the handover so the thumbnail becomes the named element
      // again. The lightbox clone is still in the DOM at this point so the
      // browser interpolates back to the thumbnail's geometry.
      setVTName(lightboxState.img, name);
      setVTName(thumb, name);
      lightboxState.root?.classList.remove('is-open');
    });

    const finish = () => {
      lightboxState.root?.setAttribute('aria-hidden', 'true');
      if (lightboxState.img) {
        lightboxState.img.src = '';
        lightboxState.img.alt = '';
      }
      setVTName(lightboxState.img, null);
      setVTName(thumb, name);
      // Restore the visibility of the swiper siblings only after the FLIP
      // back to the thumbnail has finished, so the user never sees them
      // flicker between the close transition and the original layout.
      thumb.removeAttribute('data-lightbox-active');
      delete document.body.dataset.lightboxActive;
      lightboxState.activeThumb = null;
      lightboxState.activeName = null;
    };

    if (transition && typeof (transition as { finished?: Promise<void> }).finished?.then === 'function') {
      (transition as { finished: Promise<void> }).finished
        .catch(() => undefined)
        .finally(finish);
    } else {
      finish();
    }

    thumb.focus();
  };

  // Instant teardown used by section close / SPA navigation. No animation.
  const killLightbox = (): void => {
    if (!lightboxState.root) return;
    lightboxState.root.classList.remove('is-open');
    lightboxState.root.setAttribute('aria-hidden', 'true');
    if (lightboxState.img) {
      lightboxState.img.src = '';
      lightboxState.img.alt = '';
    // Restore sibling visibility so the slider looks normal if the lightbox
    // is killed mid-transition (e.g. SPA navigation, kernel stop).
    lightboxState.activeThumb?.removeAttribute('data-lightbox-active');
    delete document.body.dataset.lightboxActive;
      setVTName(lightboxState.img, null);
    }
    if (lightboxState.activeThumb && lightboxState.activeName) {
      setVTName(lightboxState.activeThumb, lightboxState.activeName);
    }
    lightboxState.activeThumb = null;
    lightboxState.activeName = null;
  };

  // Listener setup is bound to the section lifecycle, not to each open, so
  // we only attach once. `setupLightbox` is idempotent.
  const setupLightbox = (): void => {
    if (lightboxState.root) return;

    lightboxState.root = findLightboxEl('image-lightbox');
    lightboxState.backdrop = lightboxState.root;
    lightboxState.stage = findLightboxEl('image-lightbox-stage');
    lightboxState.img = lightboxState.root?.querySelector<HTMLImageElement>('#image-lightbox-img') ?? null;
    lightboxState.closeBtn = lightboxState.root?.querySelector<HTMLButtonElement>('#image-lightbox-close') ?? null;
    lightboxState.aborter = new AbortController();
    const signal = lightboxState.aborter.signal;

    // Delegated click: any <img data-lightbox-src> inside the experience
    // section opens the lightbox. Handled at capture so it fires before
    // swiper's own click logic.
    document.addEventListener(
      'click',
      (e: MouseEvent) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;
        const thumb = target.closest<HTMLImageElement>('img[data-lightbox-src]');
        if (!thumb) return;
        if (e.defaultPrevented) return;
        const src = thumb.dataset.lightboxSrc;
        const name = thumb.dataset.lightboxName;
        if (!src || !name) return;
        e.preventDefault();
        e.stopPropagation();
        void openLightbox(thumb, src, name, thumb.dataset.lightboxAlt ?? '');
      },
      { capture: true, signal },
    );

    // Close on backdrop click (only when the target IS the backdrop, not
    // the image or the close button). The stage wrapper and the img
    // stopPropagation so clicks inside them never reach the backdrop.
    lightboxState.root?.addEventListener(
      'click',
      (e: MouseEvent) => {
        if (e.target === lightboxState.root) closeLightbox();
      },
      { signal },
    );

    // Stop propagation from the stage so clicking the image (which is
    // inside the stage) doesn't bubble to the backdrop and close the box.
    lightboxState.stage?.addEventListener(
      'click',
      (e: MouseEvent) => e.stopPropagation(),
      { signal },
    );

    lightboxState.closeBtn?.addEventListener(
      'click',
      (e: MouseEvent) => {
        e.stopPropagation();
        closeLightbox();
      },
      { signal },
    );

    // ESC closes the lightbox, but only when it's open.
    document.addEventListener(
      'keydown',
      (e: KeyboardEvent) => {
        if (e.key !== 'Escape') return;
        if (!lightboxState.root?.classList.contains('is-open')) return;
        e.preventDefault();
        closeLightbox();
      },
      { signal },
    );
  };

  // Tear down the listeners — called from stopExperience and on SPA swap.
  const teardownLightbox = (): void => {
    killLightbox();
    lightboxState.aborter?.abort();
    lightboxState.aborter = null;
    lightboxState.root = null;
    lightboxState.backdrop = null;
    lightboxState.stage = null;
    lightboxState.img = null;
    lightboxState.closeBtn = null;
    lightboxState.activeThumb = null;
    lightboxState.activeName = null;
  };

  // One-time global listener: ensure the lightbox is closed before a SPA
  // navigation so a stale overlay never survives into the next page.
  document.addEventListener('astro:before-swap', killLightbox);

  // Scroll-down tutorial overlay. Shows the "scroll down" hint at most
  // MAX_TUTORIAL_SHOWS times across visits (tracked in localStorage) and
  // auto-hides on the first scroll within the experience detail overlay.

  // The detail overlay starts hidden (the section is mounted once but
  // displayed only when the user clicks the "Experience" title). When the
  // page first loads the cards have width=0 / height=0, so every Swiper
  // initializes with collapsed dimensions and never picks up the real
  // ones when the section becomes visible. Each subsequent swipe then
  // slides from a 0px geometry into nothing, which is why only the first
  // image appeared on mobile. Forcing an `update()` right after the
  // section is shown re-measures widths/heights and repositions every
  // slide (including the loop clones).
  const refreshExperienceSwipers = (root: HTMLElement): void => {
    const elements = root.querySelectorAll<HTMLElement>('astro-swiper');
    elements.forEach((el) => {
      const swiper = (el as unknown as { astroSwiper?: { update?: () => void } }).astroSwiper;
      swiper?.update?.();
    });
  };

  const startExperience = () => {
    const root = document.querySelector<HTMLElement>('#detail-overlay')!;
    setupExperience(root );

    // "Ink Bleed" reveal on the section title.
    const title = root.querySelector<HTMLElement>('h2[data-section-id="experience"]');
    playTitleIntroAnimation(title);


    // Tear down any prior handle (close -> open flow).
    if (experienceHandle) {
      experienceHandle.destroy();
      experienceHandle = null;
    }

    // Build the scroll timeline now that the section is visible so widths
    // are computed correctly.
    experienceHandle = buildExperienceScroll(root);

    // The detail section transitioned from hidden to visible, so the
    // Swiper instances need to re-measure their containers now. A single
    // frame later is too late on mobile: the loop clones were positioned
    // using the old (0px) geometry and stayed outside the viewport.
    requestAnimationFrame(() => refreshExperienceSwipers(root));

    // Mount the image lightbox listeners. Idempotent and lightweight.
    setupLightbox();

    // Register the scroll-down tutorial to auto-hide when timeline completes
    window.__initScrollTutorial?.({
      sectionId: 'experience',
      storageKey: 'experience_tutorial_showns',
      timelineProgress: () => experienceHandle?.timeline.progress() ?? 0,
    });
  };

  const stopExperience = () => {
    if (experienceHandle) {
      experienceHandle.destroy();
      experienceHandle = null;
    }
    // Instant cleanup of the lightbox state and listeners so we never
    // leave dangling handlers when the section closes.
    teardownLightbox();
  };

  // Run on initial page load and after Astro's client-side navigation.
  const bootstrap = () => {
    const root = document.querySelector<HTMLElement>('#experienceDetailedView');
    if (root) setupExperience(root);
  };
  document.addEventListener('astro:page-load', bootstrap);
  if (document.readyState !== 'loading') {
    bootstrap();
  } else {
    document.addEventListener('DOMContentLoaded', bootstrap, { once: true });
  }

  // Expose hooks for the scene orchestrator.
  (window as unknown as { __experienceHooks?: unknown }).__experienceHooks = {
    start: startExperience,
    stop: stopExperience,
  };
</script>

<style>
  .experience-card {
    border: 2px solid #000;
    box-shadow: .5em 1em 0 #000;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
  .experience-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
      0deg,
      rgba(255, 255, 255, 0.05) 0px,
      rgba(255, 255, 255, 0.05) 1px,
      transparent 2px
    );
  pointer-events: none;
  opacity: 0.25;
  }
  .experience-card:not(:first-child) {
    transform: translateX(100vw);
  }
</style>