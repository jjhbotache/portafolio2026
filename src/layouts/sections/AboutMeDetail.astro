---
// Detail view shown when the user opens the "About me" section.
//
// Layout (rendered into the parent's 3x3 grid via `display: contents`):
//   row 1 -> title (top-left, tron-font)
//   row 2 -> typing body + three infinite technology marquees
//   row 3 -> download CV button (centered)
import { t, type Lang } from '../../i18n/utils';
import { technologyCategories } from '../../lib/technologiesByCategory';
import DetailCloseButton from '../../components/sections/DetailCloseButton.astro';
import ModelBgAnchor from '../../components/sections/ModelBgAnchor.astro';
import SectionTitle from '../../components/sections/SectionTitle.astro';
import { Icon } from 'astro-icon/components';

interface Props { lang: Lang }
const { lang } = Astro.props as Props;

// order the techs to make the make last 4 be the 4 first instead
const orderTechs = (techs: typeof technologyCategories[0]['items']) => {
  const lastFour = techs.slice(-4);
  const rest = techs.slice(0, -4);
  return [...lastFour, ...rest];
};

// Duplicate each row so the track can translate from 0 to -50% seamlessly,
// exactly like the contact marquee in ContactDetail.astro.
const duplicatedRows = technologyCategories.map((category) => ({
  ...category,
  duplicated: [...orderTechs(category.items), ...orderTechs(category.items)],
}));



// Render both language variants so the client-side JS can flip between them
// on language change without re-mounting the section.
---

<div
  id="aboutMeDetailedView"
  class="contents hidden col-start-1 row-start-1 row-span-3 col-span-3 grid grid-cols-3 grid-rows-3"
  data-section-detail
  data-section-id="aboutMe"
>
<SectionTitle
  sectionId="aboutMe"
  titleKey="sections.aboutMe.title"
  lang={lang}
  fullColSpan
/>

<!-- about me body. The gradient lives on the inner div because GSAP tweens
     `backgroundSize` on `#expanded-section-body`; if it stayed on the outer
     section the tween would mutate a no-op property. -->
<section class="col-start-1 row-start-2 col-span-3 font-pixeloid">
  <div id="expanded-section-body" class="h-full w-full flex justify-center items-center text-white bg-linear-to-r from-black/20 via-black/50 to-black/20 bg-center bg-no-repeat backdrop-blur-3xl">
    <div class="max-w-md h-full flex flex-col items-center justify-evenly py-3 text-center gap-4 px-4 md:px-0">
      <p class="text-center text-sm xl:basis-full flex items-center justify-center 2xl:text-xl" id="aboutMeBodyText" data-source-text={t(lang, 'sections.aboutMe.body')} />
      <a href="/cv.pdf" target="_blank" rel="noopener noreferrer" class="cv-download flex gap-2 hover:underline group"  >
        <span
          class="cv-download-label text-sm md:text-base font-semibold uppercase tracking-widest"
          data-lang={lang}
          data-i18n-text={`sections.aboutMe.cvDownload`}
        >{t(lang, 'sections.aboutMe.cvDownload')}</span>
        <Icon
          name="download"
          class="w-6 h-6 text-white fill-white group-hover:scale-90 transition-transform duration-100"
        />
      </a>
    </div>
  </div>
</section>

<!-- techs -->
 <section class="col-start-1 row-start-3 col-span-3 flex flex-col gap-3 justify-center">
  {duplicatedRows.map((row) => (
    <div
      class="tech-marquee-row"
      data-tech-row={row.id}
      data-tech-direction={row.id === 'back' ? 'reverse' : 'forward'}
    >
      <div class="tech-marquee-mask">
        <div
          class="tech-marquee-track"
          data-tech-track={row.id}
          data-tech-direction={row.id === 'back' ? 'reverse' : 'forward'}
        >
          {row.duplicated.map((tech) => (
            <a
              href={tech.technologyLink}
              target="_blank"
              rel="noopener noreferrer"
              class="tech-marquee-item"
              aria-label={tech.name}
              title={tech.name}
            >
              <img
                src={tech.svgUrl}
                alt={tech.name}
                loading="lazy"
                decoding="async"
                class="tech-marquee-icon"
              />
              <span class="tech-marquee-name ">{tech.name}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  ))}
 </section>

  <!-- 3D model anchor and close button shared by every detail section. -->
  <ModelBgAnchor mobileStyle='right-0 top-1/2 translate-x-[30%] -translate-y-[100%]' />
  <DetailCloseButton lang={lang} />
</div>
<style>
  /* Blinking caret used by the typewriter effect in this section. */
  .typing-caret::after {
    content: '|';
    display: inline-block;
    margin-left: 0.05em;
    color: currentColor;
    animation: typing-caret-blink 1s steps(1) infinite;
  }

  @keyframes typing-caret-blink {
    0%, 50% {
      opacity: 1;
    }
    50.01%, 100% {
      opacity: 0;
    }
  }

  /* Background gradient reveal used by the AboutMe section. Replaces the
     GSAP `backgroundSize: 0% 100% → 200% 100%` tween with a pure CSS
     animation. `@property` registers the custom property so the value
     interpolates smoothly across keyframes; without it the browser would
     just snap between the start and end values. JS only toggles the
     `.is-revealing` class to retrigger the animation on every open. */
  @property --aboutme-bg-size {
    syntax: '<percentage>';
    initial-value: 0%;
    inherits: false;
  }

  @keyframes aboutme-bg-reveal {
    from { --aboutme-bg-size: 0%; }
    to   { --aboutme-bg-size: 200%; }
  }

  #expanded-section-body {
    background-size: var(--aboutme-bg-size) 100%;
  }

  #expanded-section-body.is-revealing {
    animation: aboutme-bg-reveal 2s ease-out both;
  }

  /* CV download button fade-in. Replaces the GSAP opacity tween with a
     class swap; the transition lives on the element itself (already
     there via the existing utility classes). */
  #expanded-section-body a.cv-download {
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }

  #expanded-section-body a.cv-download.is-visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    #expanded-section-body.is-revealing {
      animation: none;
      --aboutme-bg-size: 200%;
    }
    #expanded-section-body a.cv-download {
      transition: none;
      opacity: 1;
    }
  }

  /* Technology marquee rows rendered in this section. Each row has a small
     label on the left, a fade-masked track on the right and the icons
     inside are duplicated by the Astro template so the GSAP loop is
     seamless. */
  .tech-marquee-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }

  .tech-marquee-label {
    flex-shrink: 0;
    font-family: var(--font-tron);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-secondary);
    min-width: 5.5rem;
    text-align: right;
    opacity: 0.85;
  }

  .tech-marquee-label--front { color: var(--color-secondary); }
  .tech-marquee-label--back  { color: var(--color-tertiary); }
  .tech-marquee-label--others { color: var(--color-primary); }

  .tech-marquee-mask {
    position: relative;
    flex: 1 1 auto;
    overflow: hidden;
    /* Soft fade on both edges so icons don't pop in/out harshly. */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
  }

  .tech-marquee-track {
    display: flex;
    align-items: center;
    box-sizing: content-box;
    width: max-content;
    white-space: nowrap;
    will-change: transform;
    animation: marquee-scroll 120s linear infinite;
    filter: saturate(0) brightness(0.7);
    transition: all 0.4s ease;
  }
  .tech-marquee-track[data-tech-direction="reverse"] {
    transform: translateX(-50%);
    animation: marquee-reverse-scroll 400s linear infinite;
  }
  
  .tech-marquee-track:hover {
    animation-play-state: paused;
    filter: saturate(1) brightness(1);
  }
  

  @keyframes marquee-scroll {   0% {     transform: translateX(0);   }   100% {     transform: translateX(-50%);   } }
  @keyframes marquee-reverse-scroll { 0% {   transform: translateX(-50%); } 100% {   transform: translateX(0); } }

  .tech-marquee-item {
    display: inline-flex;
    align-items: center;
    box-sizing: border-box;
    gap: 0.6rem;
    margin-right: 1.5rem;
    padding: 0.5rem 0.85rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .tech-marquee-item:hover {
    background: rgba(0, 181, 232, 0.15);
    border-color: rgba(0, 181, 232, 0.45);
    color: var(--color-secondary);
    transform: scale(.9);
  }

  .tech-marquee-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
  }

  .tech-marquee-name {
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  @media (max-width: 640px) {
    .tech-marquee-row {
      gap: 0.5rem;
    }
    .tech-marquee-label {
      min-width: 4rem;
      font-size: 0.6rem;
    }
    .tech-marquee-icon {
      width: 1.4rem;
      height: 1.4rem;
    }
    .tech-marquee-name {
      font-size: 0.75rem;
    }
  }
</style> 

<script>
  import { gsap } from 'gsap';
  import {TextPlugin} from 'gsap/TextPlugin';
  import { playTitleIntroAnimation } from '../../lib/sectionTitleReveal';

  const isMobile = window.innerWidth < 768;

  gsap.registerPlugin(TextPlugin);
  const MIN_TYPING_DURATION_S = 1.5; // seconds
  const TYPING_SPEED_MS = 20; // milliseconds per character

  // Reference to the open-timeline so `stopAboutMe` can kill the typewriter
  // cleanly if the user closes the section mid-animation. The background
  // gradient reveal and CV-link fade are now pure CSS, so they only need
  // a class swap to retrigger.
  let openTimeline: gsap.core.Timeline | null = null;

  // Triggers the CSS background-gradient reveal + typewriter + CV fade.
  // The two CSS animations are kicked off by toggling `.is-revealing` /
  // `.is-visible`; the typewriter stays on GSAP because there is no CSS
  // equivalent for per-character text reveal.
  const expandSectionBody = (): void => {
    const sectionBodyText = document.querySelector<HTMLElement>('#aboutMeBodyText');
    const sectionBody = document.querySelector<HTMLElement>('#expanded-section-body');
    const cvLink = document.querySelector<HTMLElement>('#expanded-section-body a.cv-download');

    if (sectionBody) {
      // Force a reflow so the keyframe restarts on every open even if
      // the user closes and re-opens the section rapidly.
      sectionBody.classList.remove('is-revealing');
      void sectionBody.offsetWidth;
      sectionBody.classList.add('is-revealing');
    }

    if (cvLink) {
      cvLink.classList.remove('is-visible');
      void cvLink.offsetWidth;
      cvLink.classList.add('is-visible');
    }

    if (openTimeline) {
      openTimeline.kill();
      openTimeline = null;
    }
    openTimeline = gsap.timeline();
    openTimeline.to(sectionBodyText, {
      text: sectionBodyText?.dataset.sourceText || '',
      duration: Math.max(MIN_TYPING_DURATION_S, (sectionBodyText?.dataset.sourceText?.length || 0) * TYPING_SPEED_MS / 1000),
      ease: "none"
    });
  };


  // Driven by the scene orchestrator every time the user opens the
  // About Me section (see `getSectionHooks` in lib/homeLandingScene.ts).
  // Runs both the background reveal and the title intro animation.
  const startAboutMe = (): void => {
    const root = document.querySelector<HTMLElement>('#aboutMeDetailedView');
    if (!root) return;
    expandSectionBody();
    playTitleIntroAnimation(
      root.querySelector<HTMLElement>('h2[data-section-id="aboutMe"]'),
    );
  };

  // Driven by the orchestrator when the user closes the section. Kills any
  // running typewriter tween and resets the CSS classes so the next open
  // animates from 0% again. Removing `.is-visible` lets the CSS
  // `transition: opacity 0.5s` on `.cv-download` fade it back out on its
  // own — no extra JS plumbing needed.
  const stopAboutMe = (): void => {
    if (openTimeline) {
      openTimeline.kill();
      openTimeline = null;
    }
    document.querySelector<HTMLElement>('#expanded-section-body')?.classList.remove('is-revealing');
    document.querySelector<HTMLElement>('#expanded-section-body a.cv-download')?.classList.remove('is-visible');
    const bodyText = document.querySelector<HTMLElement>('#aboutMeBodyText');
    if (bodyText) bodyText.textContent = '';
  };

  // Expose hooks for the scene orchestrator. The orchestrator calls
  // `start` when the user opens this section and `stop` when they close
  // it, so the animations never fire on initial page load.
  (window as unknown as { __aboutMeHooks?: unknown }).__aboutMeHooks = {
    start: startAboutMe,
    stop: stopAboutMe,
  };
</script>

