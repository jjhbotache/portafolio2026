---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { isLang, type Lang } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const {
  title = 'Juan José Henao — Portfolio',
  description = 'Interactive portfolio built with Astro, Three.js and GSAP.',
  lang = 'en',
} = Astro.props;

const safeLang: Lang = isLang(lang) ? lang : 'en';
---
<!doctype html>
<html lang={safeLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<ClientRouter  />
	</head>
	<body>
		<slot />
	</body>
</html>

<script>
  import { applyLangToDOM, isLang } from '../i18n/client';

  // Keep the DOM's `lang` attribute and `[data-lang]` elements in sync after
  // every client-side navigation. The first navigation is handled by the
  // inline script below to avoid a flash of wrong language.
  const sync = () => {
    const seg = window.location.pathname.split('/').filter(Boolean)[0];
    const lang = isLang(seg) ? seg : 'en';
    applyLangToDOM(lang);
  };

  document.addEventListener('astro:page-load', sync);
</script>
