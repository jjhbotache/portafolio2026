---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { t,isLang, type Lang } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const {
  lang = 'en',
} = Astro.props;

const safeLang: Lang = isLang(lang) ? lang : 'en';
---
<!doctype html>
<html lang={safeLang} style="scrollbar-gutter: stable;">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={t(safeLang,'website-description')} />
		<title>{t(safeLang,'website-title')}</title>

		<!--
		  Kick off the heaviest 3D assets as soon as the HTML is parsed so the
		  scene is mostly cached by the time `initializeHomeLandingScene`
		  starts asking for them. Without these hints the browser would not
		  start the network round-trip until the module imports evaluate,
		  which costs ~3-5 s on a cold load.

		  The list is the union of every model that `homeLandingTitles.ts`,
		  `homeLandingDisk.ts` and `homeLandingEnvironment.ts` will request,
		  independent of the active locale (the model cache in
		  `modelCache.ts` deduplicates so this fires once per file per page
		  load, not once per language).
		-->
		<link rel="preload" as="fetch" href="/3d/disk.stl" crossorigin="anonymous" fetchpriority="high" />
		<link rel="preload" as="fetch" href="/3d/platform.stl" crossorigin="anonymous" fetchpriority="high" />
		<link rel="preload" as="fetch" href="/3d/floor.stl" crossorigin="anonymous" fetchpriority="high" />
		<link rel="preload" as="fetch" href="/3d/mountain.stl" crossorigin="anonymous" />
		<link rel="preload" as="fetch" href="/3d/man_thinking.stl" crossorigin="anonymous" />
		<link rel="preload" as="fetch" href="/3d/the_creation_of_adam.glb" crossorigin="anonymous" />
		<link rel="preload" as="fetch" href="/3d/gears.gltf" crossorigin="anonymous" />
		<link rel="preload" as="fetch" href="/3d/experiencia.stl" crossorigin="anonymous" />
		<link rel="preload" as="fetch" href="/3d/acerca de mi.stl" crossorigin="anonymous" />
		<link rel="preload" as="fetch" href="/3d/contacto.stl" crossorigin="anonymous" />
		<link rel="preload" as="fetch" href="/3d/proyectos.stl" crossorigin="anonymous" />
		<!--
		  Preload the hero portrait so the `waitForHeroImage()` gate inside
		  `buildLandingTimeline` resolves as soon as the raster is decoded
		  (instead of waiting for the next animation frame after the layout
		  flushes). `fetchpriority="low"` matches the `<img>` attribute so
		  the browser doesn't deprioritise other assets.
		-->
		<link rel="preload" as="image" href="/me.png" crossorigin="anonymous" fetchpriority="low" />
		
		<!-- ===================== Open Graph ===================== -->
		<meta property="og:type"        content="website" />
		<meta property="og:title"       content={t(safeLang, 'og-title')} />
		<meta property="og:description" content={t(safeLang, 'og-description')} />
		<meta property="og:image"       content={safeLang === 'en' ? '/img_en.png' : '/img_es.png'} />
		<meta property="og:image:width"  content="1849" />
		<meta property="og:image:height" content="1174" />
		<meta property="og:url"         content={t(safeLang, 'og-url')} />
		<meta property="og:locale"      content={t(safeLang, 'og-locale')} />
		<ClientRouter  />
	</head>
	<body>
		<slot />
	</body>
</html>

<script>
  import { applyLangToDOM, isLang } from '../i18n/client';

  // Keep the DOM's `lang` attribute and `[data-lang]` elements in sync after
  // every client-side navigation. The first navigation is handled by the
  // inline script below to avoid a flash of wrong language.
  const sync = () => {
    const seg = window.location.pathname.split('/').filter(Boolean)[0];
    const lang = isLang(seg) ? seg : 'en';
    applyLangToDOM(lang);
  };

  document.addEventListener('astro:page-load', sync);
</script>
