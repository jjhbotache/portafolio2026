---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components'
import ExperienceDetail from '../../components/sections/ExperienceDetail.astro';
import AboutMeDetail from '../../components/sections/AboutMeDetail.astro';
import ContactDetail from '../../components/sections/ContactDetail.astro';
import ProjectsDetail from '../../components/sections/ProjectsDetail.astro';
import LanguageToggle from '../../components/LanguageToggle.astro';
import { isLang, t, type Lang } from '../../i18n/utils';

const rawLang = Astro.params.lang;
const lang: Lang = isLang(rawLang) ? rawLang : 'en';

const titleByLang: Record<Lang, string> = {
  en: 'Juan José Huertas — Portfolio',
  es: 'Juan José Huertas — Portafolio',
};
const descriptionByLang: Record<Lang, string> = {
  en: 'Interactive portfolio built with Astro, Three.js and GSAP.',
  es: 'Portafolio interactivo construido con Astro, Three.js y GSAP.',
};
---
<Layout title={titleByLang[lang]} description={descriptionByLang[lang]} lang={lang}>
  <LanguageToggle />

  <div
    id="hero-mask"
    class="masked h-full w-full"
    >
    <div id="content" class="relative flex items-center justify-end gap-10 h-screen bg-linear-to-br from-gray-900 to-gray-950">
      <div class="basis-3/5 pr-[15em]">
        <h1 class="bit8-font text-6xl font-bold text-end bg-linear-to-br from-secondary via-tertiary to-primary to-80% bg-clip-text text-transparent align-middle " >
          Juan Jose Huertas
        </h1>
      </div>

      <img
        src="/me.png"
        alt="me"
        loading="lazy"
        decoding="async"
        fetchpriority="low"
        class="fixed h-[110vh]  transform left-[25%] -translate-x-1/2 top-[65%] -translate-y-1/2 drop-shadow-secondary/20 drop-shadow-xl "
      />

      <div class=" fixed bottom-[15%] left-[50%] transform -translate-x-1/2 h-40 w-40 flex items-center justify-center ">
        <Icon name="downArrow" class="w-10 h-10 text-secondary animate-bounce" />
      </div>

    </div>
    
  </div>
  <div class="h-px"></div>
  
  <div id="three-overlay" aria-hidden="true">
    <div id="tutorial-overlay" aria-hidden="true">
      <div id="tutorial-icon" class="tutorial-icon" aria-hidden="true">
        <!-- Cursor icon (desktop) -->
        <Icon name="cursor" id="cursor-icon" class="w-24 h-24 text-secondary" />

        <!-- Tap icon (touch) -->
        <Icon name="tap" id="tap-icon" class="w-24 h-24 text-secondary" />

      </div>
    </div>
  </div>

  <!-- a 3*3 grid -->
  <div id="detail-overlay" class="fixed inset-0 z-50 opacity-0 overflow-y-auto pointer-events-none hidden grid-cols-3 grid-rows-3  transition-opacity duration-300 backdrop-blur-xs" >
    <ExperienceDetail lang={lang} />
    <AboutMeDetail lang={lang} />
    <ContactDetail lang={lang} />
    <ProjectsDetail lang={lang} />
  </div>
  

</Layout>

<style>
  #content, .hero-mask {
    will-change: transform, opacity, -webkit-mask-size, mask-size;
  }
  #content{
    /* padding: 1rem; */
    transform: scale(1.5);
  }

    #three-overlay {
      position: fixed;
      inset: 0;
      z-index: 40;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.4s ease;
      background: #020617;
      pointer-events: none;
    }

    #three-overlay canvas {
      width: 100%;
      height: 100%;
      display: block;
    }
    /* Tutorial overlay */
    #tutorial-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      z-index: 60;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.2s ease, visibility 0.2s ease;
    }

    #tutorial-overlay.visible {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    #tutorial-icon {
      width: 96px;
      height: 96px;
      display: flex;
      align-items: center;
      justify-content: center;
      transform-origin: 50% 50%;
      color: #8b5cf6; /* tailwind secondary-ish */
      filter: drop-shadow(0 8px 20px rgba(0,0,0,0.5));
    }

    /* show cursor by default, show tap on coarse pointers (touch) */
    #cursor-icon { display: block; }
    #tap-icon { display: none; }

    @media (pointer: coarse) {
      #cursor-icon { display: none; }
      #tap-icon { display: block; }
    }
</style>

<script>
  import { initializeHomeLandingScene } from '../../lib/homeLandingScene';

  const seg = window.location.pathname.split('/').filter(Boolean)[0];
  const lang = seg === 'es' || seg === 'en' ? seg : 'en';

  initializeHomeLandingScene(lang as 'en' | 'es').catch((err) => {
    console.error('Failed to initialize landing scene:', err);
  });
</script>