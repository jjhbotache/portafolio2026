---
<Layout title={titleByLang[lang]} description={descriptionByLang[lang]} lang={lang}>
  <LanguageToggle />

  <div
    id="hero-mask"
    class="masked h-full w-full"
    >
    <div id="content" class="relative flex items-center justify-end gap-10 h-screen bg-linear-to-br from-gray-900 to-gray-950">
      <div class="basis-3/5 pr-[15em]">
        <h1 class="pixel-font tracking-widest font-bold text-6xl  text-end bg-linear-to-br from-secondary via-tertiary to-primary to-80% bg-clip-text text-transparent align-middle " >
          Juan Jose Huertas
        </h1>
      </div>

      <img
        src="/me.png"
        alt="me"
        loading="lazy"
        decoding="async"
        fetchpriority="low"
        class="fixed h-[110vh]  transform left-[25%] -translate-x-1/2 top-[65%] -translate-y-1/2 drop-shadow-secondary/20 drop-shadow-xl "
      />

      <div id="landing-arrow" class=" fixed bottom-[15%] left-[50%] transform -translate-x-1/2 h-40 w-40 flex items-center justify-center animate-bounce transition-opacity duration-300" data-tutorial-icon>
        <span class="text-secondary text-6xl font-pixeloid transform rotate-180 ">^</span>
      </div>

    </div>
    
  </div>
  
  <div id="three-overlay" aria-hidden="true">
    <div id="tutorial-overlay" aria-hidden="true">
      <div id="tutorial-icon" class="tutorial-icon" aria-hidden="true">
        <!-- Cursor icon (desktop) -->
        <Icon name="cursor" id="cursor-icon" class="w-24 h-24 text-secondary" />

        <!-- Tap icon (touch) -->
        <Icon name="tap" id="tap-icon" class="w-24 h-24 text-secondary" />

      </div>
    </div>
  </div>

  <!-- a 3*3 grid -->
  <div id="detail-overlay" class="fixed inset-0 z-50 opacity-0 overflow-y-auto pointer-events-none hidden grid-cols-3 grid-rows-3  transition-opacity duration-300 backdrop-blur-xs" >
    <ExperienceDetail lang={lang} />
    <AboutMeDetail lang={lang} />
    <ContactDetail lang={lang} />
    <ProjectsDetail lang={lang} />
  </div>
  
  <!-- dev -->
  <!-- <div class="h-[60vh] w-full absolute top-0 left-0 bg-white">
  </div> -->

</Layout>

<style>
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background: var(--color-gray-950);
  }
  html{
    scrollbar-gutter: stable;
  }
  html::-webkit-scrollbar-track {
    background: red;
  }
  
  /* Hero mask used by the landing section. Drives the SVG sparks mask,
     its size/position and the secondary-color overlay opacity. The custom
     properties are mutated at runtime by `homeLandingScene.ts`. */
  .masked {
    position: relative;
    overflow: hidden;
    --landing-mask-size: 500%;
    --mask-pos: 50% 64%;
    --hero-before-opacity: 0;
    -webkit-mask-image: url('/sparks2.svg');
    mask-image: url('/sparks2.svg');
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: var(--landing-mask-size);
    mask-size: var(--landing-mask-size);
    -webkit-mask-position: var(--mask-pos);
    mask-position: var(--mask-pos);
  }

  .masked::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-secondary);
    opacity: var(--hero-before-opacity);
    pointer-events: none;
    z-index: 2;
  }

  .masked > * {
    position: relative;
    z-index: 1;
  }

  #content, .hero-mask {
    will-change: transform, opacity, -webkit-mask-size, mask-size;
  }
  #content{
    /* padding: 1rem; */
    transform: scale(1.5);
  }

    #three-overlay {
      position: fixed;
      inset: 0;
      z-index: 40;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.4s ease;
      background: #020617;
      pointer-events: none;
    }

    #three-overlay canvas {
      width: 100%;
      height: 100%;
      display: block;
    }
    /* Tutorial overlay */
    #tutorial-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      z-index: 60;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.2s ease, visibility 0.2s ease;
    }

    #tutorial-overlay.visible {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    #tutorial-icon {
      width: 96px;
      height: 96px;
      display: flex;
      align-items: center;
      justify-content: center;
      transform-origin: 50% 50%;
      color: #8b5cf6; /* tailwind secondary-ish */
      filter: drop-shadow(0 8px 20px rgba(0,0,0,0.5));
    }

    /* Landing scroll-down arrow.
       Hidden until homeLandingScene signals everything (GSAP + Three.js +
       STL fetches + landing timeline) is ready, then fades in via the
       `transition-opacity` utility on the element itself. */
    #landing-arrow {
      opacity: 0;
      pointer-events: none;
    }

    #landing-arrow.loaded {
      opacity: 1;
    }

    /* show cursor by default, show tap on coarse pointers (touch) */
    #cursor-icon { display: block; }
    #tap-icon { display: none; }

    @media (pointer: coarse) {
      #cursor-icon { display: none; }
      #tap-icon { display: block; }
    }

    /* ============================================================
       View Transitions API — zoom + reorder of the project card
       ============================================================ */
    /* default duration for the crossfade of the card itself and the
       slide of its inner panels. `*` covers every named snapshot. */
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation-duration: 500ms;
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* a quicker fade for the rest of the page so the surrounding UI
       doesn't drag behind the card animation. */
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation-duration: 300ms;
    }

    /* respect users who asked for less motion */
    @media (prefers-reduced-motion: reduce) {
      ::view-transition-old(*),
      ::view-transition-new(*) {
        animation-duration: 1ms !important;
      }
    }

</style>

<script>
  import { initializeHomeLandingScene } from '../../lib/homeLandingScene';

  const seg = window.location.pathname.split('/').filter(Boolean)[0];
  const lang = seg === 'es' || seg === 'en' ? seg : 'en';

  initializeHomeLandingScene(lang as 'en' | 'es').catch((err) => {
    console.error('Failed to initialize landing scene:', err);
  });

</script>