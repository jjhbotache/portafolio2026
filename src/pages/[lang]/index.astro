---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components'
import ExperienceDetail from '../../components/sections/ExperienceDetail.astro';
import AboutMeDetail from '../../components/sections/AboutMeDetail.astro';
import ContactDetail from '../../components/sections/ContactDetail.astro';
import ProjectsDetail from '../../components/sections/ProjectsDetail.astro';
import LanguageToggle from '../../components/LanguageToggle.astro';
import { isLang, t, type Lang } from '../../i18n/utils';

const rawLang = Astro.params.lang;
const lang: Lang = isLang(rawLang) ? rawLang : 'en';

const titleByLang: Record<Lang, string> = {
  en: 'Juan José Huertas — Portfolio',
  es: 'Juan José Huertas — Portafolio',
};
const descriptionByLang: Record<Lang, string> = {
  en: 'Interactive portfolio built with Astro, Three.js and GSAP.',
  es: 'Portafolio interactivo construido con Astro, Three.js y GSAP.',
};

const exp = {
  id: 'dpagos',
  title: 'Plataforma Dpagos',
  period: 'Mar 2025 — Abr 2025',
  description: 'Plataforma de puntos de venta para lotería con React, TypeScript, FastAPI y SQLAlchemy.',
  contentHtml: '<p><strong>Desarrollé</strong> esta plataforma que permite a usuarios puntos de venta vender lotería utilizando el servicio de Billuyo y a un administrador, manejar puntos de venta, su saldo, sus solicitudes de saldo y demás. Se creó utilizando <strong>React</strong> con <strong>TypeScript</strong> para el frontend y <em>FastAPI</em> con <em>SQLAlchemy</em> para el backend. Implementé interfaces modernas con Shadcn, Recharts y Tailwind.</p>\n',
  technologies: [
    'React',
    'TypeScript',
    'FastAPI',
    'Shadcn',
    'Recharts',
    'SQLAlchemy',
    'Tailwind'
  ],
  imgs: [
    'https://res.cloudinary.com/ddt7qdant/image/upload/v1757945606/Captura_de_pantalla_2025-04-17_155832_l4oywu_befdsq.png',
    'https://res.cloudinary.com/ddt7qdant/image/upload/v1757945606/Captura_de_pantalla_2025-04-17_155942_sw3cfo_xy7q0t.png',
    'https://res.cloudinary.com/ddt7qdant/image/upload/v1757945606/Captura_de_pantalla_2025-04-17_160011_bxkqzo_psnbic.png',
    'https://res.cloudinary.com/ddt7qdant/image/upload/v1757945606/dpagos_uj37xt.png',
    'https://res.cloudinary.com/ddt7qdant/image/upload/v1757945606/Screenshot_24_xiqgar_hckrzw.png',
    'https://res.cloudinary.com/ddt7qdant/image/upload/v1757945606/Screenshot_23_ydrxt2_opzixd.png',
    'https://res.cloudinary.com/ddt7qdant/image/upload/v1757945607/Screenshot_25_k190iv_xgdk3d.png'
  ],
  periodByLang: { es: 'Mar 2025 — Abr 2025', en: 'Mar 2025 — Apr 2025' },
  enterprises: [
    {
      name: 'Billuyo',
      logo: 'https://billuyo.com.co/favicon.png',
      url: 'https://billuyo.com.co'
    },
    {
      name: 'Dpagos',
      logo: 'https://dpagos-platform-front.vercel.app/logo.svg',
      url: 'https://dpagos-platform-front.vercel.app'
    }
  ]
}
---
<Layout title={titleByLang[lang]} description={descriptionByLang[lang]} lang={lang}>
  <LanguageToggle />

  <div
    id="hero-mask"
    class="masked h-full w-full"
    >
    <div id="content" class="relative flex items-center justify-end gap-10 h-screen bg-linear-to-br from-gray-900 to-gray-950">
      <div class="basis-3/5 pr-[15em]">
        <h1 class="pixel-font tracking-widest font-bold text-6xl  text-end bg-linear-to-br from-secondary via-tertiary to-primary to-80% bg-clip-text text-transparent align-middle " >
          Juan Jose Huertas
        </h1>
      </div>

      <img
        src="/me.png"
        alt="me"
        loading="lazy"
        decoding="async"
        fetchpriority="low"
        class="fixed h-[110vh]  transform left-[25%] -translate-x-1/2 top-[65%] -translate-y-1/2 drop-shadow-secondary/20 drop-shadow-xl "
      />

      <div class=" fixed bottom-[15%] left-[50%] transform -translate-x-1/2 h-40 w-40 flex items-center justify-center ">
        <Icon name="downArrow" class="w-10 h-10 text-secondary animate-bounce" />
      </div>

    </div>
    
  </div>
  
  <div id="three-overlay" aria-hidden="true">
    <div id="tutorial-overlay" aria-hidden="true">
      <div id="tutorial-icon" class="tutorial-icon" aria-hidden="true">
        <!-- Cursor icon (desktop) -->
        <Icon name="cursor" id="cursor-icon" class="w-24 h-24 text-secondary" />

        <!-- Tap icon (touch) -->
        <Icon name="tap" id="tap-icon" class="w-24 h-24 text-secondary" />

      </div>
    </div>
  </div>

  <!-- a 3*3 grid -->
  <div id="detail-overlay" class="fixed inset-0 z-50 opacity-0 overflow-y-auto pointer-events-none hidden grid-cols-3 grid-rows-3  transition-opacity duration-300 backdrop-blur-xs" >
    <ExperienceDetail lang={lang} />
    <AboutMeDetail lang={lang} />
    <ContactDetail lang={lang} />
    <ProjectsDetail lang={lang} />
  </div>
  
  <!-- dev -->
  <!-- <div class="h-[60vh] w-full absolute top-0 left-0 bg-white">
  </div> -->

</Layout>

<style>
  /* Hero mask used by the landing section. Drives the SVG sparks mask,
     its size/position and the secondary-color overlay opacity. The custom
     properties are mutated at runtime by `homeLandingScene.ts`. */
  .masked {
    position: relative;
    overflow: hidden;
    --landing-mask-size: 500%;
    --mask-pos: 50% 64%;
    --hero-before-opacity: 0;
    -webkit-mask-image: url('/sparks2.svg');
    mask-image: url('/sparks2.svg');
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: var(--landing-mask-size);
    mask-size: var(--landing-mask-size);
    -webkit-mask-position: var(--mask-pos);
    mask-position: var(--mask-pos);
  }

  .masked::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-secondary);
    opacity: var(--hero-before-opacity);
    pointer-events: none;
    z-index: 2;
  }

  .masked > * {
    position: relative;
    z-index: 1;
  }

  #content, .hero-mask {
    will-change: transform, opacity, -webkit-mask-size, mask-size;
  }
  #content{
    /* padding: 1rem; */
    transform: scale(1.5);
  }

    #three-overlay {
      position: fixed;
      inset: 0;
      z-index: 40;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.4s ease;
      background: #020617;
      pointer-events: none;
    }

    #three-overlay canvas {
      width: 100%;
      height: 100%;
      display: block;
    }
    /* Tutorial overlay */
    #tutorial-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      z-index: 60;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.2s ease, visibility 0.2s ease;
    }

    #tutorial-overlay.visible {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    #tutorial-icon {
      width: 96px;
      height: 96px;
      display: flex;
      align-items: center;
      justify-content: center;
      transform-origin: 50% 50%;
      color: #8b5cf6; /* tailwind secondary-ish */
      filter: drop-shadow(0 8px 20px rgba(0,0,0,0.5));
    }

    /* show cursor by default, show tap on coarse pointers (touch) */
    #cursor-icon { display: block; }
    #tap-icon { display: none; }

    @media (pointer: coarse) {
      #cursor-icon { display: none; }
      #tap-icon { display: block; }
    }
</style>

<script>
  import { initializeHomeLandingScene } from '../../lib/homeLandingScene';

  const seg = window.location.pathname.split('/').filter(Boolean)[0];
  const lang = seg === 'es' || seg === 'en' ? seg : 'en';

  initializeHomeLandingScene(lang as 'en' | 'es').catch((err) => {
    console.error('Failed to initialize landing scene:', err);
  });
</script>