---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components'
import ExperienceDetail from '../../layouts/sections/ExperienceDetail.astro';
import AboutMeDetail from '../../layouts/sections/AboutMeDetail.astro';
import ContactDetail from '../../layouts/sections/ContactDetail.astro';
import ProjectsDetail from '../../layouts/sections/ProjectsDetail.astro';
import Menu from '../../components/Menu.astro';
import { isLang, t, type Lang } from '../../i18n/utils';

const rawLang = Astro.params.lang;
const lang: Lang = isLang(rawLang) ? rawLang : 'en';

const titleByLang: Record<Lang, string> = {
  en: 'Juan José Huertas — Portfolio',
  es: 'Juan José Huertas — Portafolio',
};
const descriptionByLang: Record<Lang, string> = {
  en: 'Interactive portfolio built with Astro, Three.js and GSAP.',
  es: 'Portafolio interactivo construido con Astro, Three.js y GSAP.',
};



---
<Layout title={titleByLang[lang]} description={descriptionByLang[lang]} lang={lang}>
  <Menu />

  <div
    id="hero-mask"
    class="masked h-screen w-full"
    >
    <div id="content" class="relative flex items-center justify-end gap-0 md:gap-10 h-screen bg-linear-to-br from-gray-900 to-gray-950 overflow-hidden">
      <img
        src="/me.png"
        alt="me"
        loading="lazy"
        decoding="async"
        fetchpriority="low"
        class="fixed h-[110vh] -z-1 transform left-[25%] -translate-x-1/2 top-[65%] -translate-y-1/2 drop-shadow-secondary/20 drop-shadow-xl opacity-15 md:opacity-100 "
      />
      
      <div class="pr-[22vw] pixel-font basis-[85%] md:basis-3/5 md:pr-[17vw] 2xl:pr-[16em] flex flex-col justify-center items-end gap-2 text-end">
        <h1 class=" tracking-widest font-bold text-2xl md:text-6xl 2xl:text-8xl   bg-linear-to-br from-secondary via-tertiary to-primary to-80% bg-clip-text text-transparent align-middle " >
          Juan Jose Huertas
        </h1>
        <small id="subtitle" class="text-[0.4em] md:text-[0.5em]  text-white/50 italic tracking-widest  pr-1 md:pr-5 ">
          {t(lang, 'hero-subtitle')}
        </small>
      </div>

      

      <div id="landing-arrow" class=" fixed bottom-[15%] left-[50%] transform -translate-x-1/2 h-40 w-40 flex items-center justify-center animate-bounce transition-all opacity-0 duration-500" data-tutorial-icon>
        <span class="text-secondary text-6xl font-pixeloid transform rotate-180 ">^</span>
      </div>

    </div>
    
  </div>
  
  <!-- a 3*3 grid -->
  <div id="detail-overlay" class="fixed inset-0 z-50 opacity-0  pointer-events-none hidden grid-cols-3 grid-rows-3  transition-opacity duration-300 backdrop-blur-xs" >
    <ExperienceDetail lang={lang} />
    <AboutMeDetail lang={lang} />
    <ContactDetail lang={lang} />
    <ProjectsDetail lang={lang} />
  </div>
  
  

  
  <!-- dev -->
  <!-- <div class="h-screen w-full absolute top-0 left-0 bg-[#222]">
  </div> -->

  <div id="three-overlay" aria-hidden="true"/>
  
  
  <div id="tutorial-overlay"> 
    <div id="driverjs-tutorial" class="absolute z-40 left-[50%] top-[50%] transform -translate-x-1/2 -translate-y-[95%] md:-translate-y-[65%]  w-[80vw] h-[10vh] md:w-[50vw] md:h-[65vh] "/>
    
    <Icon name="cursor" id="cursor-icon-tutorial" class="hidden " />
    
  </div>
  <small id="skip-tutorial" class="hidden z-40 font-pixeloid fixed bottom-4 left-[50%] transform -translate-x-1/2 text-white/50 hover:text-white">{t(lang, 'skip-tutorial')}</small>
  
</Layout>



<style>
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background: var(--color-gray-950);
  }
  html{
    scrollbar-gutter: stable;
  }
  html::-webkit-scrollbar-track {
    background: red;
  }
  
  /* Hero mask used by the landing section. Drives the SVG sparks mask,
     its size/position and the secondary-color overlay opacity. The custom
     properties are mutated at runtime by `homeLandingScene.ts`. */
  .masked {
    position: relative;
    overflow: hidden;
    --landing-mask-size: 500%;
    --mask-pos: 50% 64%;
    --hero-before-opacity: 0;
    -webkit-mask-image: url('/sparks2.svg');
    mask-image: url('/sparks2.svg');
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: var(--landing-mask-size);
    mask-size: var(--landing-mask-size);
    -webkit-mask-position: var(--mask-pos);
    mask-position: var(--mask-pos);
  }
  /* if mobile */
  @media (max-width: 768px) {
    .masked {
      --landing-mask-size: 1000%;
      --mask-pos: 50% 70%;
    }
  }

  .masked::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-secondary);
    opacity: var(--hero-before-opacity);
    pointer-events: none;
    z-index: 2;
  }

  .masked > * {
    position: relative;
    z-index: 1;
  }

  /* Detail overlay opacity. JS still owns the `display: grid|none` flip
     (it has to be a discrete property for layout), but the opacity fade
     between visible and hidden is a pure CSS transition. */
  #detail-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  #content, .hero-mask {
    will-change: transform, opacity, -webkit-mask-size, mask-size;
  }
  #content{
    /* padding: 1rem; */
    transform: scale(1.5);
  }

  #three-overlay {
    position: fixed;
    inset: 0;
    z-index: 40;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease;
    background: #020617;
    pointer-events: none;
  }

  #three-overlay canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Tutorial overlay */
  #tutorial-overlay {
    position: fixed;
    inset: 0;
    z-index: 40;
  }
  #cursor-icon-tutorial {
    width: 96px;
    height: 96px;
    color: #8b5cf6; /* tailwind secondary-ish */
    filter: drop-shadow(0 8px 20px rgba(0,0,0,0.5));
    transition: all 0.3s ease-in-out;
    animation: corner-to-corner 4s ease-in-out infinite alternate;
  }
  @keyframes corner-to-corner {
    from { transform: translate(calc(95vw - 96px), 50vh); }
    to { transform: translate(5vw, 50vh); }
  }


    /* show cursor by default, show tap on coarse pointers (touch) */
    #cursor-icon { display: block; }
    #tap-icon { display: none; }

    @media (pointer: coarse) {
      #cursor-icon { display: none; }
      #tap-icon { display: block; }
    }

    /* ============================================================
       View Transitions API — zoom + reorder of the project card
       ============================================================ */
    /* default duration for the crossfade of the card itself and the
       slide of its inner panels. `*` covers every named snapshot. */
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation-duration: 500ms;
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* a quicker fade for the rest of the page so the surrounding UI
       doesn't drag behind the card animation. */
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation-duration: 300ms;
    }

    /* respect users who asked for less motion */
    @media (prefers-reduced-motion: reduce) {
      ::view-transition-old(*),
      ::view-transition-new(*) {
        animation-duration: 1ms !important;
      }
    }
    

</style>

<script>
  import { initializeHomeLandingScene } from '../../lib/homeLandingScene';

  const seg = window.location.pathname.split('/').filter(Boolean)[0];
  const lang = seg === 'es' || seg === 'en' ? seg : 'en';

  initializeHomeLandingScene(lang as 'en' | 'es').catch((err) => {
    console.error('Failed to initialize landing scene:', err);
  });

</script>